# Build from the versioned source archive.
pkgname=veil-for-zen
pkgver=0.9.0beta
pkgrel=1
export SOURCE_DATE_EPOCH=1793577600
pkgdesc='Independent sidebar appearance editor for Zen Browser'
arch=('any')
url='https://github.com/znyderw/zen-sidebar-studio'
license=('MIT')
depends=('python' 'pyside6')
makedepends=('python-installer' 'python-setuptools' )
source=("veil-for-zen-0.9.0-beta.tar.gz")
# tools/prepare_release.py replaces this with the exact source archive hash.
sha256sums=('PENDING_SOURCE_ARCHIVE')

build() {
  cd "$srcdir/veil-for-zen-0.9.0-beta"
  python tools/build.py --wheel
}

package() {
  cd "$srcdir/veil-for-zen-0.9.0-beta"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/licenses/$pkgname/NOTICE.md"
  install -Dm644 packaging/veil-for-zen.desktop "$pkgdir/usr/share/applications/veil-for-zen.desktop"
  install -Dm644 veil_for_zen/assets/veil-for-zen.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/veil-for-zen.svg"
}
